#:kivy 1.0.9

<TextSequence>:
    lab:lab
    lab2:lab2

    Label:
        id:lab
        text: "Hello"
        font_size: 70  
        x: root.width / 3
        y: root.height / 2


    Label:
        id:lab2
        text: "Hello"
        font_size: 70  
        center_x: root.width / 3 *2
        center_y: root.height / 2

<Text>:
    lab:lab

    Label:
        id:lab
        font_size: 70  
        center_x: root.width / 2
        center_y: root.height / 2
        text: "Hello"

<DoubleText>:
    text1: text1
        
    Text:
        id: text1

    Label:
        id: text2
        font_size: 70  
        center_x: root.width - root.text2.width
        center_y: root.height / 2